    "preview": "node src/utils/build.mjs && node src/utils/preview.mjs",
    "export:wp": "node src/utils/build.mjs && node src/utils/export-wp.mjs",
    "push:wp": "node src/utils/push-wp.mjs",
    "serve": "npx serve public"
  }
}
