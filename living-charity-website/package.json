{
  "name": "living-charity-website",
  "version": "0.1.0",
  "private": true,
  "description": "Vorabversion der Website für Living Charity e. V. — statisch, abhängigkeitsfrei, WordPress-fertig vorbereitet",
  "type": "module",
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "node src/utils/build.mjs",
